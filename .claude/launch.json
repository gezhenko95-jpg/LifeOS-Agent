{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lifeos-api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "lifeos-ui-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "lifeos-agent/app/web/static"],
      "port": 8080
    }
  ]
}
