# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не коммитится в git (см. .gitignore).

app_name=LifeOS Agent
app_version=0.1.0
environment=development

host=0.0.0.0
port=8000

# PostgreSQL. При локальном запуске (docker-compose up -d db + uvicorn на хосте) — localhost.
# Внутри docker-compose api/bot сами переопределяют это значение на db:5432.
database_url=postgresql+asyncpg://postgres:postgres@localhost:5432/lifeos

# Токен бота из @BotFather в Telegram.
telegram_bot_token=

# Telegram ID единственного пользователя системы (проект single-user).
# Узнать свой ID: напишите боту /start.
owner_telegram_user_id=0

# Утренний брифинг (см. flows/001-morning-briefing.md)
morning_briefing_enabled=true
morning_briefing_hour=8
morning_briefing_minute=0

# Вечерняя рефлексия (см. flows/005-evening-reflection.md)
evening_reflection_enabled=true
evening_reflection_hour=21
evening_reflection_minute=0

# Напоминания о задачах с конкретным сроком (specs/002-tasks.md)
task_reminders_enabled=true
task_reminders_interval_seconds=60

# AI Service (OpenRouter) — фолбэк для Conversation Engine, когда
# rule-based парсер (app/conversation/parser.py) не понял сообщение.
# Пусто = фолбэк выключен, ничего не меняется.
# Ключ: https://openrouter.ai/keys, модели: https://openrouter.ai/models
openrouter_api_key=
openrouter_model=openai/gpt-4o-mini
openrouter_base_url=https://openrouter.ai/api/v1

# --- Безопасность (см. AUDIT.md) ---

# Токен доступа к REST API (заголовок X-API-Token). Пусто = API закрыт
# полностью (503 на всё, кроме /health) — забытая настройка должна
# ломать доступ, а не молча снимать защиту. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
api_token=

# Пароль Postgres. Подставляется в docker-compose.yml и в database_url.
# ВАЖНО: применяется только при первой инициализации пустого volume —
# для уже существующей БД менять через ALTER USER (см. HANDOFF.md).
POSTGRES_PASSWORD=

# Логировать каждый SQL с параметрами. НЕ включать на проде: в параметрах
# едут тексты дневниковых записей, а логи контейнера не приватное место.
sql_echo=false

# Публичный адрес /ui — он же единственный разрешённый CORS-origin.
public_ui_url=

# --- Остальные слоты дневного ритма (см. flows/009-daily-rhythm.md) ---
proactive_prompts_enabled=true
proactive_prompt_morning_hour=10
proactive_prompt_morning_minute=30
proactive_prompt_midday_hour=14
proactive_prompt_midday_minute=0
proactive_prompt_evening_hour=19
proactive_prompt_evening_minute=0

# Еженедельный дайджест, воскресенье (flows/007-weekly-digest.md)
weekly_digest_enabled=true
weekly_digest_hour=20
weekly_digest_minute=0

# Нэджи по целям/привычкам (flows/008-nudges.md)
nudges_enabled=true
nudges_hour=9
nudges_minute=0

# Personal Insights, 1-е число месяца (specs/009-personal-insights.md)
monthly_insights_enabled=true
monthly_insights_hour=12
monthly_insights_minute=0

# Семантический поиск по памяти (specs/011-semantic-memory-search.md)
openrouter_embedding_model=openai/text-embedding-3-small
memory_embeddings_enabled=true
memory_embedding_batch_size=20
memory_embedding_interval_seconds=300

# Google Drive, Фаза 2 Media Inbox (specs/010-media-inbox.md).
# Файла нет = фича просто выключена.
drive_token_file=token.json

# Голосовой ввод (specs/012-voice-input.md) — тот же openrouter_api_key,
# что и выше, отдельного ключа не нужно. Пусто = ключ не задан, фича
# выключена, как и весь остальной AI.
openrouter_transcription_model=openai/whisper-large-v3
voice_max_duration_seconds=300

# Сколько дампов БД держать на Google Drive (scripts/backup_db.sh)
backup_keep=14
