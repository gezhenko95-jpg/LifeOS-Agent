# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не коммитится в git (см. .gitignore).

app_name=LifeOS Agent
app_version=0.1.0
environment=development

host=0.0.0.0
port=8000

# PostgreSQL. При локальном запуске (docker-compose up -d db + uvicorn на хосте) — localhost.
# Внутри docker-compose api/bot сами переопределяют это значение на db:5432.
database_url=postgresql+asyncpg://postgres:postgres@localhost:5432/lifeos

# Токен бота из @BotFather в Telegram.
telegram_bot_token=

# Telegram ID единственного пользователя системы (проект single-user).
# Узнать свой ID: напишите боту /start.
owner_telegram_user_id=0

# Утренний брифинг (см. flows/001-morning-briefing.md)
morning_briefing_enabled=true
morning_briefing_hour=8
morning_briefing_minute=0

# Вечерняя рефлексия (см. flows/005-evening-reflection.md)
evening_reflection_enabled=true
evening_reflection_hour=21
evening_reflection_minute=0

# Напоминания о задачах с конкретным сроком (specs/002-tasks.md)
task_reminders_enabled=true
task_reminders_interval_seconds=60

# AI Service (OpenRouter) — фолбэк для Conversation Engine, когда
# rule-based парсер (app/conversation/parser.py) не понял сообщение.
# Пусто = фолбэк выключен, ничего не меняется.
# Ключ: https://openrouter.ai/keys, модели: https://openrouter.ai/models
openrouter_api_key=
openrouter_model=openai/gpt-4o-mini
openrouter_base_url=https://openrouter.ai/api/v1
